# Copy to .env. Every variable is prefixed DAAS_.
DAAS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/daas
DAAS_ADMIN_TOKEN=change-me-to-a-long-random-string

# Ingestion
DAAS_SOCRATA_APP_TOKEN=           # free at https://data.ny.gov/profile/edit/developer_settings
DAAS_BACKFILL_DAYS=90
DAAS_LOOKBACK_DAYS=7
DAAS_INGEST_INTERVAL_MINUTES=360

# Self-serve free tier
DAAS_SIGNUP_ENABLED=true

# Stripe (billing endpoints return 503 until set)
DAAS_STRIPE_SECRET_KEY=
DAAS_STRIPE_WEBHOOK_SECRET=
DAAS_STRIPE_PRICE_STARTER=
DAAS_STRIPE_PRICE_GROWTH=
DAAS_STRIPE_PRICE_SCALE=
DAAS_PUBLIC_BASE_URL=http://localhost:8000
